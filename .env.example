# Supabase Postgres connection
# Find this at: Supabase Dashboard → Settings → Database → Connection string → "Session mode" URI
# Make sure to URL-encode any special characters in the password.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# last.fm API credentials
# Get from: https://www.last.fm/api/account/create
LASTFM_API_KEY=your_api_key_here
LASTFM_USERNAME=your_lastfm_username_here

# Spotify Developer app
# Create at: https://developer.spotify.com/dashboard
# Redirect URI must be set to: http://127.0.0.1:8888/callback
SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here

# Generated by running: uv run python scripts/spotify_auth.py
# This refresh token is what the cron job and dashboard use to mint short-lived access tokens.
SPOTIFY_REFRESH_TOKEN=
