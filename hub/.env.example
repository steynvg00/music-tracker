# Rotor hub — server-side environment (Vercel → Project → Settings → Environment Variables).
# Placeholders only. Never commit real values; .env is gitignored.

# Public URL of the deployment, no trailing slash. The OAuth redirect URI is ORIGIN + /auth/callback
# and must be registered in BOTH Spotify apps below.
ORIGIN=https://rotor-example.vercel.app

# The hub's own Spotify app (developer.spotify.com/dashboard → Create app).
SPOTIFY_CLIENT_ID=your-hub-app-client-id
SPOTIFY_CLIENT_SECRET=your-hub-app-client-secret

# The existing cron app (same values as the GitHub secrets SPOTIFY_CLIENT_ID / SPOTIFY_CLIENT_SECRET).
# Used only for Settings › Connections › "Connect crons" (option A). Leave empty to skip.
SPOTIFY_CRON_CLIENT_ID=your-cron-app-client-id
SPOTIFY_CRON_CLIENT_SECRET=your-cron-app-client-secret

# Your Spotify user id (spotify:user:<this>). Every other account is rejected after OAuth.
OWNER_SPOTIFY_ID=your-spotify-user-id

# Supabase Supavisor TRANSACTION pooler (port 6543), table-owner role. Serverless-safe.
DATABASE_URL=postgresql://postgres.project-ref:password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# 32 random bytes, base64. Generate: openssl rand -base64 32
# SESSION_SECRET keys the session-cookie hash and signs the OAuth state cookie.
SESSION_SECRET=generate-with-openssl-rand-base64-32
# TOKEN_ENC_KEY encrypts tokens at rest. Must be the SAME value as the GitHub Actions secret TOKEN_ENC_KEY.
TOKEN_ENC_KEY=generate-with-openssl-rand-base64-32

# Hub jobs (R2): "Refresh this playlist now", snapshot "Rebuild now", "Shuffle the deck", test notification.
# Fine-grained PAT, this repository only, permission "Actions: Read and write". Used ONLY to start
# .github/workflows/hub-jobs.yml (POST /repos/{repo}/actions/workflows/hub-jobs.yml/dispatches).
# Without it: no jobs; Shuffle the deck starts the deck over, Refresh now is disabled.
GITHUB_DISPATCH_TOKEN=
GITHUB_REPOSITORY=steynvg00/music-tracker

# Web Push (R2). Public application server key (base64url). The matching PRIVATE key goes only into
# the GitHub Actions secret VAPID_PRIVATE_KEY. Generate both: uv run python scripts/generate_vapid_keys.py
VAPID_PUBLIC_KEY=

# Elsewhere (R4): YouTube Data API v3 key, server-side only (never sent to the browser).
# Google Cloud Console → APIs & Services → enable "YouTube Data API v3" → Credentials → API key,
# restrict it to that API. Imports public/unlisted playlists (1 unit per 50 items; default quota
# 10,000 units/day). Without it, YouTube import is disabled; SoundCloud needs no key.
YOUTUBE_API_KEY=
